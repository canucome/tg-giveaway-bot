# ---- 必填 ----
BOT_TOKEN=123456789:AA...            # @BotFather 拿的 token
ADMIN_IDS=123456789,987654321        # 支持逗号分隔或 JSON 数组 [123456789,987654321]

# ---- 运行模式 ----
# 留空 => Long Polling（本地/内网可直接跑，不需要公网 IP）
# 填公网 https 根地址 => Webhook 模式，此时 WEBHOOK_SECRET 至少 8 位
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ---- 人机验证（Cloudflare Turnstile）----
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0x4AAAAAAA...       # Turnstile widget 的 Site Key
TURNSTILE_SECRET_KEY=0x4AAAAAAA...     # Turnstile 的 Secret Key
# 用户打开验证页的公网地址；留空则回退 WEBHOOK_BASE_URL，两者都空时
# 创建「带验证码的抽奖」会被直接拒绝（不会发出无法打开的链接）
PUBLIC_BASE_URL=https://giveaway.example.com

# ---- 反滥用（默认全部开启，改成 false / 0 才关闭）----
# 账号年龄闸门：Telegram user_id 单调递增，给出下限就能挡掉刚注册的号。
# 0 = 只装闸门不过滤；用 /gate <抽奖id> 看现有参与者 ID 分布再决定阈值。
ACCOUNT_AGE_GATE=true
MIN_USER_ID=0
# 验证页每个 IP 每分钟的请求上限（GET+POST），0 = 关闭；重启后清零
VERIFY_RATE_PER_MINUTE=10
# 前面挂了 Caddy/Nginx 时用 X-Forwarded-For 取真实客户端 IP
TRUST_FORWARDED_FOR=true

# ---- 数据库 / 其他 ----
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
DEFAULT_LANG=zh
TZ=Asia/Shanghai
LOG_LEVEL=INFO
DROP_PENDING_UPDATES=false
